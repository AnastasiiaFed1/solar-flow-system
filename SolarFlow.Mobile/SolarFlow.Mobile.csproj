<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>SolarFlow.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Повне відключення XamlC компилятора -->
		<MauiXamlCValidateOnly>false</MauiXamlCValidateOnly>
		<MauiStrictXamlCompilation>false</MauiStrictXamlCompilation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SolarFlow.Core\SolarFlow.Core.csproj" />
	</ItemGroup>

</Project>