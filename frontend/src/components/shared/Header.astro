
---
import Navigation from './Navigation.astro';
---

<header class="site-header">
  <div class="header-container">
    <a href="/" class="logo" aria-label="SolarFlow — головна">
      <span class="logo-icon" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none">
          <circle
            cx="20"
            cy="20"
            r="8"
            stroke="#22d3ee"
            stroke-width="2.8"
          />
          <path
            d="M20 3V8
               M20 32V37
               M3 20H8
               M32 20H37
               M8 8L11.5 11.5
               M28.5 28.5L32 32
               M32 8L28.5 11.5
               M11.5 28.5L8 32"
            stroke="#5eead4"
            stroke-width="2.8"
            stroke-linecap="round"
          />
        </svg>
      </span>

      <span class="logo-text">Solar<span>Flow</span></span>
    </a>

    <Navigation />

    <div class="header-actions">
      <span class="system-status">
        <span class="status-dot"></span>
        Система активна
      </span>

      <span
        class="user-icon"
        title="Профіль користувача"
        aria-label="Профіль користувача"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21v-2a8 8 0 0 1 16 0v2H4Z" />
        </svg>
      </span>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background: rgba(12, 20, 31, 0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--shell-border);
    position: relative;
    z-index: 20;
  }

  .header-container {
    max-width: 1440px;
    min-height: 76px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-icon {
    display: flex;
    width: 39px;
    height: 39px;
    align-items: center;
    justify-content: center;
  }

  .logo-icon svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 6px rgba(34, 211, 238, 0.35));
  }

  .logo-text {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -0.7px;
    color: var(--shell-text);
  }

  .logo-text span {
    color: var(--shell-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }

  .system-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 15px;
    border-radius: 999px;
    background: rgba(22, 35, 51, 0.85);
    border: 1px solid rgba(6, 182, 212, 0.3);
    color: var(--shell-text);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 10px rgba(52, 211, 153, 0.6);
  }

  .user-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    color: var(--shell-text);
  }

  .user-icon svg {
    width: 23px;
    height: 23px;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 900px) {
    .header-container {
      padding: 14px 20px;
      flex-wrap: wrap;
      gap: 14px;
    }

    .header-actions {
      margin-left: auto;
    }

    .system-status {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .header-container {
      padding: 12px 16px;
    }

    .logo-text {
      font-size: 21px;
    }

    .logo-icon {
      width: 33px;
      height: 33px;
    }
  }
</style>
