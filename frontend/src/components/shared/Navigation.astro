
---
const navigation = [
  { name: 'Головна', href: '/' },
  { name: 'Можливості', href: '/features' },
  { name: 'Сервіс', href: '/service' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  return href === '/'
    ? currentPath === '/'
    : currentPath === href ||
        currentPath.startsWith(`${href}/`);
}
---

<nav class="navigation" aria-label="Основна навігація">
  {navigation.map((item) => (
    <a
      href={item.href}
      class:list={['nav-link', { active: isActive(item.href) }]}
      aria-current={isActive(item.href) ? 'page' : undefined}
    >
      {item.name}
    </a>
  ))}
</nav>


<style>
  .navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border: 1px solid transparent;
    border-radius: 12px;
    color: var(--shell-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav-link:hover {
    color: var(--shell-primary);
    background: rgba(34, 211, 238, 0.07);
    border-color: rgba(34, 211, 238, 0.15);
  }

  .nav-link.active {
    color: var(--shell-primary);
    font-weight: 600;
    background: rgba(6, 182, 212, 0.13);
    border-color: rgba(6, 182, 212, 0.35);
    box-shadow: inset 0 0 12px rgba(34, 211, 238, 0.07);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--shell-primary);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .navigation {
      order: 3;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
    }
  }

  @media (max-width: 520px) {
    .navigation {
      gap: 4px;
    }

    .nav-link {
      padding: 9px 12px;
      font-size: 13px;
    }
  }
</style>

