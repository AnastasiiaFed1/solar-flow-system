---

<Layout
  title="Інструкції — SolarFlow"
  description="Детальні інструкції з використання модулів SolarFlow."
>
  <section class="guides-page">
    <a class="back-link" href="/service">
      <span aria-hidden="true">←</span>
      Повернутися до сервісу
    </a>

    <header class="page-heading">
      <div class="heading-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 6.5C9.5 4.8 6.5 4.5 3 5V19C6.5 18.5 9.5 18.8 12 20.5" />
          <path d="M12 6.5C14.5 4.8 17.5 4.5 21 5V19C17.5 18.5 14.5 18.8 12 20.5" />
          <path d="M12 6.5V20.5" />
        </svg>
      </div>

      <div>
        <h1>Інструкції</h1>
        <p>
          Покрокові посібники з використання
          функціональних модулів SolarFlow.
        </p>
      </div>
    </header>

    <div class="guides-list">
      {guides.map((guide, index) => (
        <details class="guide-card">
          <summary class="guide-summary">
            <span class="guide-number">
              {String(index + 1).padStart(2, '0')}
            </span>

            <span class="guide-heading">
              <span class="guide-title">{guide.title}</span>
              <span class="guide-subtitle">{guide.subtitle}</span>
            </span>

            <svg class="chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9L12 15L18 9" />
            </svg>
          </summary>

          <div class="guide-content">
            {guide.sections.map((section) => (
              <section class="instruction-section">
                <h2>{section.heading}</h2>

                <ol>
                  {section.steps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              </section>
            ))}

            <div class="guide-note">
              <span class="note-label">Важливо</span>
              <p>{guide.note}</p>
            </div>

            <a class="module-link" href={guide.href}>
              Перейти до модуля
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style>
  .guides-page {
    max-width: 1048px;
    min-height: calc(100vh - 76px);
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 36px;
    color: var(--shell-muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--shell-primary);
  }

  .page-heading {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 36px;
  }

  .heading-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    color: var(--shell-primary);
    background: rgba(6, 182, 212, 0.09);
    border: 1px solid var(--shell-border);
    border-radius: 16px;
  }

  .heading-icon svg {
    width: 30px;
    height: 30px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .page-heading h1 {
    margin: 0 0 8px;
    color: var(--shell-text);
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.2;
  }

  .page-heading p {
    max-width: 650px;
    margin: 0;
    color: var(--shell-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .guides-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .guide-card {
    overflow: hidden;
    background: var(--shell-surface);
    backdrop-filter: blur(12px);
    border: 1px solid var(--shell-border);
    border-radius: var(--shell-card-radius);
    box-shadow: var(--shell-card-shadow);
    transition: border-color 0.2s ease;
  }

  .guide-card:hover,
  .guide-card[open] {
    border-color: var(--shell-border-hover);
  }

  .guide-summary {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    cursor: pointer;
    list-style: none;
  }

  .guide-summary::-webkit-details-marker {
    display: none;
  }

  .guide-summary:focus-visible {
    outline: 2px solid var(--shell-primary);
    outline-offset: -4px;
    border-radius: var(--shell-card-radius);
  }

  .guide-number {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
