
---
import Layout from '../../layouts/Layout.astro';

const modules = [
  {
    title: 'Dashboard',
    href: '/dashboard',
    description: 'Моніторинг генерації, споживання, заряду акумулятора та енергетичних потоків.',
  },
  {
    title: 'Конфігуратор СЕС',
    href: '/configurator',
    description: 'Підбір компонентів, налаштування обладнання та 3D-візуалізація системи.',
  },
  {
    title: 'Smart Grid',
    href: '/smart-grid',
    description: 'Пріоритети електроприладів, сценарії навантаження та баланс енергоспоживання.',
  },
  {
    title: 'Фінанси та екологія',
    href: '/finance',
    description: 'Розрахунки економії, окупності, енергетичного обміну й екологічного впливу.',
  },
  {
    title: 'Симуляція та 3D',
    href: '/simulation',
    description: 'Моделювання сонячної генерації за різних погодних умов та орієнтації панелей.',
  },
];

const updates = [
  {
    category: 'Функціональність',
    title: 'Інтеграція основних модулів',
    description:
      'У спільній платформі доступні п’ять модулів: Dashboard, Конфігуратор СЕС, Smart Grid, Фінанси та екологія, Симуляція та 3D.',
  },
  {
    category: 'Інтерфейс',
    title: 'Єдине оформлення Astro-оболонки',
    description:
      'Головну сторінку, навігацію, розділи «Можливості» та «Сервіс» оформлено в стилі Deep Slate / Cyan-Teal.',
  },
  {
    category: 'Документація',
    title: 'Інструкції та центр допомоги',
    description:
      'Додано посібники з використання модулів і відповіді на поширені запитання користувачів.',
  },
  {
    category: 'Розробка',
    title: 'Робота з демонстраційними даними',
    description:
      'Окремі модулі можуть використовувати локальні тестові дані, коли серверне API недоступне. Режим роботи залежить від конкретного модуля.',
  },
];
---

<Layout
  title="Оновлення системи — SolarFlow"
  description="Поточний стан та інформація про розвиток SolarFlow."
>
  <section class="updates-page">
    <a href="/service" class="back-link">
      <span aria-hidden="true">←</span>
      Повернутися до сервісу
    </a>

    <header class="page-heading">
      <div class="heading-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M20 7V3L16 7L20 11" />
          <path d="M20 7A8 8 0 0 0 5.5 5.5" />
          <path d="M4 17V21L8 17L4 13" />
          <path d="M4 17A8 8 0 0 0 18.5 18.5" />
        </svg>
      </div>

      <div>
        <h1>Оновлення системи</h1>
        <p>
          Реалізовані можливості, зміни інтерфейсу
          та поточний стан розробки SolarFlow.
        </p>
      </div>
    </header>

    <div class="status-panel">
      <div class="status-heading">
        <span class="status-dot"></span>
        <h2>Поточний стан платформи</h2>
      </div>

      <p>
        SolarFlow перебуває в активній розробці.
        Основні функціональні модулі доступні для
        ознайомлення та тестування. Частина функцій
        може працювати з демонстраційними даними.
      </p>
    </div>

    <section class="content-section">
      <h2 class="section-title">Реалізовані можливості</h2>

      <div class="modules-grid">
        {modules.map((module) => (
          <a href={module.href} class="module-card">
            <span class="module-status">
              <span class="small-dot"></span>
              Доступний модуль
            </span>

            <h3>{module.title}</h3>
            <p>{module.description}</p>

            <span class="card-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2 class="section-title">Історія розвитку</h2>
      <p class="section-description">
        Основні етапи реалізації функцій та інтерфейсу.
        Це перелік змін, а не журнал офіційних релізів.
      </p>

      <div class="timeline">
        {updates.map((update) => (
          <article class="update-item">
            <div class="timeline-indicator" aria-hidden="true">
              <span></span>
            </div>

            <div class="update-content">
              <span class="update-category">
                {update.category}
              </span>

              <h3>{update.title}</h3>
              <p>{update.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="info-panel">
      <div>
        <h2>Потрібна допомога з функціями?</h2>
        <p>
          Перегляньте інструкції або знайдіть
          відповідь у центрі допомоги.
        </p>
      </div>

      <div class="info-actions">
        <a href="/service/guides" class="button-primary">
          Інструкції
        </a>

        <a href="/service/help" class="button-secondary">
          Центр допомоги
        </a>
      </div>
    </section>
  </section>
</Layout>

<style>
  .updates-page {
    max-width: 1120px;
    min-height: calc(100vh - 76px);
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 36px;
    color: var(--shell-muted);
    font-size: 14px;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--shell-primary);
  }

  .page-heading {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 36px;
  }

  .heading-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    color: var(--shell-primary);
    background: rgba(6, 182, 212, 0.09);
    border: 1px solid var(--shell-border);
    border-radius: 16px;
  }

  .heading-icon svg {
    width: 30px;
    height: 30px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .page-heading h1 {
    margin: 0 0 8px;
    color: var(--shell-text);
    font-size: clamp(26px, 3vw, 34px);
  }

  .page-heading p {
    max-width: 660px;
    margin: 0;
    color: var(--shell-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .status-panel {
    padding: 26px 28px;
    margin-bottom: 44px;
    background: var(--shell-surface);
    border: 1px solid var(--shell-border);
    border-radius: var(--shell-card-radius);
    box-shadow: var(--shell-card-shadow);
  }

  .status-heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .status-dot,
  .small-dot {
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    background: #34d399;
    border-radius: 50%;
  }

  .status-panel h2 {
    margin: 0;
    color: var(--shell-text);
    font-size: 18px;
  }

  .status-panel p,
  .section-description {
    margin: 0;
    color: var(--shell-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .content-section {
    margin-bottom: 44px;
  }

  .section-title {
    margin: 0 0 20px;
    color: var(--shell-text);
    font-size: 23px;
  }

  .section-description {
    margin: -8px 0 24px;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .module-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 180px;
    padding: 24px;
    background: var(--shell-surface);
    border: 1px solid var(--shell-border);
    border-radius: var(--shell-card-radius);
    text-decoration: none;
    box-shadow: var(--shell-card-shadow);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .module-card:hover {
    transform: translateY(-4px);
    border-color: var(--shell-border-hover);
  }

  .module-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: #34d399;
    font-size: 12px;
  }

  .small-dot {
    width: 7px;
    height: 7px;
  }

  .module-card h3 {
    margin: 0 0 10px;
    color: var(--shell-text);
    font-size: 18px;
  }

  .module-card p {
    margin: 0;
    padding-right: 14px;
    color: var(--shell-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .card-arrow {
    position: absolute;
    right: 22px;
    bottom: 20px;
    color: var(--shell-primary);
    font-size: 20px;
  }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 14px;
    bottom: 20px;
    width: 1px;
    background: var(--shell-border);
  }

  .update-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .timeline-indicator {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 24px;
    height: 24px;
  }

  .timeline-indicator span {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--shell-primary);
    border: 3px solid var(--shell-bg-start);
    box-shadow: 0 0 0 1px var(--shell-border);
  }

  .update-content {
    flex: 1;
    min-width: 0;
    padding: 20px 24px;
    background: var(--shell-surface);
    border: 1px solid var(--shell-border);
    border-radius: 14px;
  }

  .update-category {
    color: var(--shell-primary);
    font-size: 12px;
    font-weight: 700;
  }

  .update-content h3 {
    margin: 8px 0 10px;
    color: var(--shell-text);
    font-size: 17px;
  }

  .update-content p {
    margin: 0;
    color: var(--shell-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .info-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
    background: var(--shell-surface);
    border: 1px solid var(--shell-border);
    border-radius: var(--shell-card-radius);
  }

  .info-panel h2 {
    margin: 0 0 8px;
    color: var(--shell-text);
    font-size: 18px;
  }

  .info-panel p {
    margin: 0;
    color: var(--shell-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .info-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .button-primary,
  .button-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .button-primary {
    background: var(--shell-accent-gradient);
    color: #081720;
  }

  .button-secondary {
    color: var(--shell-text);
    background: var(--shell-surface-inner);
    border: 1px solid var(--shell-border-hover);
  }

  a:focus-visible {
    outline: 2px solid var(--shell-primary);
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .updates-page {
      padding: 32px 16px 64px;
    }

    .modules-grid {
      grid-template-columns: 1fr;
    }

    .page-heading {
      gap: 14px;
    }

    .heading-icon {
      width: 46px;
      height: 46px;
    }

    .heading-icon svg {
      width: 24px;
      height: 24px;
    }

    .info-panel {
      flex-direction: column;
      align-items: stretch;
    }

    .info-actions {
      flex-direction: column;
    }

    .update-content {
      padding: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .module-card {
      transition: none;
    }
  }
</style>
