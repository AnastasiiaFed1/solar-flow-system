
---
import Layout from '../../layouts/Layout.astro';

const categories = [
  {
    title: 'Загальні запитання',
    questions: [
      {
        question: 'Що таке SolarFlow?',
        answer: 'SolarFlow — вебплатформа для проєктування, моніторингу та моделювання сонячних електростанцій. Вона об’єднує кілька функціональних модулів в одному інтерфейсі.',
      },
      {
        question: 'З чого почати роботу?',
        answer: 'Відкрийте розділ «Можливості», оберіть потрібний модуль і ознайомтеся з його функціями. Покрокові пояснення доступні в розділі «Інструкції».',
      },
      {
        question: 'Чи потрібна реальна сонячна електростанція?',
        answer: 'Для ознайомлення з інтерфейсом і моделювання енергетичних сценаріїв реальна електростанція не потрібна. Дані, представлені в демонстраційних модулях, не слід вважати показниками реального обладнання.',
      },
    ],
  },
  {
    title: 'Моніторинг та моделювання',
    questions: [
      {
        question: 'Для чого потрібен Dashboard?',
        answer: 'Dashboard призначений для перегляду показників генерації та споживання електроенергії, стану акумулятора й енергетичних потоків.',
      },
      {
        question: 'Чим відрізняються Конфігуратор і Симуляція?',
        answer: 'Конфігуратор використовується для налаштування параметрів енергосистеми, а Симуляція — для дослідження її роботи за визначених умов.',
      },
      {
        question: 'Що можна робити у Smart Grid?',
        answer: 'Smart Grid допомагає аналізувати споживання електроприладів та використовувати передбачені модулем засоби керування ними.',
      },
      {
        question: 'Що показує розділ «Фінанси та екологія»?',
        answer: 'Цей розділ призначений для оцінювання економічних та екологічних показників сонячної електростанції.',
      },
    ],
  },
  {
    title: 'Типові проблеми',
    questions: [
      {
        question: 'Сторінка не відкривається. Що робити?',
        answer: 'Перевірте адресу сторінки та інтернет-з’єднання. Спробуйте оновити вкладку. Якщо ви запускаєте локальну версію SolarFlow, переконайтеся, що сервер розробки працює.',
      },
      {
        question: 'Чому показники можуть відрізнятися від очікуваних?',
        answer: 'Результати можуть залежати від вибраних налаштувань, вхідних параметрів і логіки моделювання. Перевірте поточні параметри відповідного модуля.',
      },
      {
        question: 'Куди повідомити про помилку?',
        answer: 'Скористайтеся розділом «Зворотний зв’язок» після підключення каналу надсилання повідомлень або повідомте команду розробників через погоджений канал зв’язку.',
      },
    ],
  },
];
---

<Layout
  title="Центр допомоги — SolarFlow"
  description="Відповіді на поширені запитання про платформу SolarFlow."
>
  <section class="help-page">
    <a href="/service" class="back-link">
      <span aria-hidden="true">←</span>
      Повернутися до сервісу
    </a>

    <div class="page-heading">
      <div class="heading-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" />
          <path d="M9.5 9A2.5 2.5 0 1 1 13.5 11C12.5 11.7 12 12.3 12 13.5" />
          <path d="M12 17H12.01" />
        </svg>
      </div>

      <div>
        <h1>Центр допомоги</h1>
        <p>Відповіді на поширені запитання про використання SolarFlow.</p>
      </div>
    </div>

    <div class="help-categories">
      {categories.map((category) => (
        <section class="faq-category">
          <h2>{category.title}</h2>

          <div class="faq-list">
            {category.questions.map((item) => (
              <details class="faq-item">
                <summary>
                  <span>{item.question}</span>

                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9L12 15L18 9" />
                  </svg>
                </summary>

                <div class="faq-answer">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="help-bottom">
      <div>
        <h2>Не знайшли відповіді?</h2>
        <p>Перейдіть до розділу зворотного зв'язку.</p>
      </div>

      <a href="/service/feedback" class="feedback-link">
        Зворотний зв'язок
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .help-page {
    max-width: 1048px;
    min-height: calc(100vh - 76px);
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 36px;
    color: var(--shell-muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--shell-primary);
  }

  .page-heading {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 42px;
  }

  .heading-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    color: var(--shell-primary);
    background: rgba(6, 182, 212, 0.09);
    border: 1px solid var(--shell-border);
    border-radius: 16px;
  }

  .heading-icon svg {
    width: 30px;
    height: 30px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .page-heading h1 {
    margin: 0 0 8px;
    color: var(--shell-text);
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.2;
  }

  .page-heading p {
    margin: 0;
    color: var(--shell-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .help-categories {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .faq-category h2 {
    margin: 0 0 18px;
    color: var(--shell-text);
    font-size: 20px;
    font-weight: 700;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    overflow: hidden;
    background: var(--shell-surface);
    border: 1px solid var(--shell-border);
    border-radius: 14px;
    box-shadow: var(--shell-card-shadow);
    transition: border-color 0.2s ease;
  }

  .faq-item:hover,
  .faq-item[open] {
    border-color: var(--shell-border-hover);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 24px;
    color: var(--shell-text);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--shell-primary);
    outline-offset: -4px;
  }

  .faq-item summary svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--shell-primary);
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .faq-item[open] summary svg {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 24px 22px;
  }

  .faq-answer p {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--shell-border);
    color: var(--shell-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .help-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding: 28px;
    background: var(--shell-surface);
    border: 1px solid var(--shell-border);
    border-radius: var(--shell-card-radius);
  }

  .help-bottom h2 {
    margin: 0 0 8px;
    color: var(--shell-text);
    font-size: 18px;
  }

  .help-bottom p {
    margin: 0;
    color: var(--shell-muted);
    font-size: 14px;
  }

  .feedback-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-shrink: 0;
    padding: 12px 18px;
    border-radius: 10px;
    background: var(--shell-accent-gradient);
    color: #081720;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: box-shadow 0.2s ease;
  }

  .feedback-link:hover {
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.3);
  }

  .back-link:focus-visible,
  .feedback-link:focus-visible {
    outline: 2px solid var(--shell-primary);
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    .help-page {
      padding: 32px 16px 64px;
    }

    .page-heading {
      gap: 14px;
    }

    .heading-icon {
      width: 46px;
      height: 46px;
    }

    .heading-icon svg {
      width: 24px;
      height: 24px;
    }

    .faq-item summary {
      padding: 18px;
    }

    .faq-answer {
      padding: 0 18px 18px;
    }

    .help-bottom {
      align-items: stretch;
      flex-direction: column;
      padding: 22px;
    }

    .feedback-link {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .faq-item,
    .faq-item summary svg,
    .feedback-link {
      transition: none;
    }
  }
</style>
