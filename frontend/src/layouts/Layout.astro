---
import Header from '../components/shared/Header.astro';
import '../styles/variables.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SolarFlow',
  description = 'Платформа для проєктування, моніторингу та моделювання сонячних електростанцій.',
} = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
  </head>

  <body>
	<Header />
  
	<main>
	  <slot />
	</main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    width: 100%;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.5;
  }
</style>
